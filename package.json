{
  "name": "nucase-agent",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:mssql": "npm run db:migrate:mssql -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:mssql": "npm run db:seed:mssql -w server --",
    "test": "npm run test -w server",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
