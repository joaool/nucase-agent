DATABASE_URL=postgres://postgres:postgres@localhost:5432/nucase
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set to "true" once served over HTTPS in production so the auth cookie requires it
COOKIE_SECURE=false
# Powers the AI Chat financial-data agent — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling-capable model slug OpenRouter serves; defaults to Claude Sonnet if unset
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Railway + Vanna migration, Phase 1 (see .claude/skills/railway-vanna-migration/SKILL.md).
# Schema-only for now — not read by server/src, only by db/migrate.mssql.ts. Optional: matches
# the `docker compose up -d` mssql service by default, so this only needs setting if you're
# pointing at a different SQL Server instance.
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=nucase;User Id=sa;Password=NucaseDev!2025;TrustServerCertificate=true;Encrypt=false

# Railway + Vanna migration, Phase 4 (see .claude/skills/railway-vanna-migration/SKILL.md,
# decision 12) — read by server/src/config/tenantCrypto.ts to decrypt the per-tenant SQL Server
# passwords stored in the tenant_connections table (populated via
# `npm run db:seed:tenant -- --company=... --server=... --database=... --user=... --password=...`,
# see that script's header comment). Optional here for the same reason OPENROUTER_API_KEY isn't
# — a fresh clone with no tenants provisioned yet shouldn't fail to boot — but required for any
# Financial Data request to actually resolve a connection. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_CREDENTIALS_KEY=
