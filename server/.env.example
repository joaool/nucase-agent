DATABASE_URL=postgres://postgres:postgres@localhost:5432/nucase
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set to "true" once served over HTTPS in production so the auth cookie requires it
COOKIE_SECURE=false
# Powers the AI Chat financial-data agent — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling-capable model slug OpenRouter serves; defaults to Claude Sonnet if unset
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Railway + Vanna migration, Phase 1 (see .claude/skills/railway-vanna-migration/SKILL.md).
# Schema-only for now — not read by server/src, only by db/migrate.mssql.ts. Optional: matches
# the `docker compose up -d` mssql service by default, so this only needs setting if you're
# pointing at a different SQL Server instance.
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=nucase;User Id=sa;Password=NucaseDev!2025;TrustServerCertificate=true;Encrypt=false

# Railway + Vanna migration, Phase 3 (see .claude/skills/railway-vanna-migration/SKILL.md,
# decision 10) — read by server/src/config/mssql.ts. One hardcoded SQL Server target for now
# (Phase 4 replaces this with a per-tenant resolver). Server/port/database/user default to this
# repo's local dev setup (SQLEXPRESS, TCP enabled on a static port, a dedicated db_datareader
# login) — only MSSQL_APP_PASSWORD needs setting for that to work as-is.
MSSQL_APP_SERVER=DESKTOP-I7-1270
MSSQL_APP_PORT=14333
MSSQL_APP_DATABASE=MetalurgicaAurora
MSSQL_APP_USER=nucase_app
MSSQL_APP_PASSWORD=
# Leave both unset locally (defaults match SQLEXPRESS/Docker, which have no real cert to
# validate). A target that requires real TLS — e.g. Azure SQL Database, used as the customer-demo
# hardcoded target on Railway — needs MSSQL_APP_ENCRYPT=true and
# MSSQL_APP_TRUST_SERVER_CERTIFICATE=false.
# MSSQL_APP_ENCRYPT=true
# MSSQL_APP_TRUST_SERVER_CERTIFICATE=false
