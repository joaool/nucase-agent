DATABASE_URL=postgres://postgres:postgres@localhost:5432/nucase
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set to "true" once served over HTTPS in production so the auth cookie requires it
COOKIE_SECURE=false
# Powers the AI Chat financial-data agent — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling-capable model slug OpenRouter serves; defaults to Claude Sonnet if unset
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
