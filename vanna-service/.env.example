# Railway + Vanna migration, Phase 5 (see .claude/skills/railway-vanna-migration/SKILL.md,
# decision 2). Reuses the same OpenRouter account/key the Node server uses — get one at
# https://openrouter.ai/keys if you don't already have server/.env.example's value handy.
OPENROUTER_API_KEY=
# Any tool-calling-capable model slug OpenRouter serves; defaults to Claude Sonnet if unset.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Sent as the HTTP-Referer attribution header on OpenRouter calls; matches server/.env.example.
CLIENT_ORIGIN=http://localhost:5173
