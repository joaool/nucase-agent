# Railway + Vanna migration, Phase 5 (see .claude/skills/railway-vanna-migration/SKILL.md,
# decision 2). Reuses the same OpenRouter account/key the Node server uses — get one at
# https://openrouter.ai/keys if you don't already have server/.env.example's value handy.
OPENROUTER_API_KEY=
# Any tool-calling-capable model slug OpenRouter serves; defaults to Claude Sonnet if unset.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Sent as the HTTP-Referer attribution header on OpenRouter calls; matches server/.env.example.
CLIENT_ORIGIN=http://localhost:5173

# Railway + Vanna migration, Phase 7 (see .claude/skills/railway-vanna-migration/SKILL.md).
# vanna_app's own Postgres connection — a least-privilege login scoped to the `vanna` schema
# only (server/db/setupVannaRole.ts), never the app's main Postgres credential. For local dev,
# points at the same Postgres server/.env's DATABASE_URL uses, just a different, restricted
# login/database.
VANNA_DATABASE_URL=postgresql://vanna_app:CHANGE_ME@localhost:5432/nucase
